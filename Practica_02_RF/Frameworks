<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PetTask - Actualizar Tarea</title>

  <!-- Fuentes: Questrial (títulos) y Onest (contenido) -->
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500&family=Questrial&display=swap" rel="stylesheet">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- CSS personalizado (guía de estilos) -->
  <style>
    :root {
      --blanco: #E5EAF5;
      --rosa: #FF6F82;
      --azul-claro: #8FA3ED;
      --azul: #557FFC;
      --azul-oscuro: #1E1E50;
    }

    /* Texto normal: Onest, 16 px, peso 400 */
    body {
      background-color: var(--blanco);
      color: var(--azul-oscuro);
      font-family: 'Onest', sans-serif;
      font-size: 16px;
      font-weight: 400;
    }

    /* Títulos: Questrial, mínimo 32 px, peso 400 */
    h1 {
      font-family: 'Questrial', sans-serif;
      font-size: 32px;
      font-weight: 400;
      color: var(--azul);
    }

    /* Subtítulos: Questrial, mínimo 22 px, peso 500 */
    h2 {
      font-family: 'Questrial', sans-serif;
      font-size: 22px;
      font-weight: 500;
    }

    /* Navbar: 106 px de alto en escritorio, texto 16 px, área táctil 45 px */
    .navbar-petask {
      background-color: var(--azul-oscuro);
      min-height: 64px;
    }
    @media (min-width: 992px) {
      .navbar-petask { min-height: 106px; }
    }
    .navbar-petask .navbar-brand {
      font-family: 'Questrial', sans-serif;
      font-size: 22px;
      color: var(--blanco);
    }
    .navbar-petask .nav-link {
      color: var(--blanco);
      font-size: 16px;
      min-width: 45px;
      min-height: 45px;
      display: flex;
      align-items: center;
    }

    /* Contenido: ancho máximo 1200 px, gaps y márgenes máx. 24 px */
    .container { max-width: 1200px; }

    /* Cards: esquinas 12-50 px, padding 16-32 px (usamos 24 px) */
    .card-petask {
      border: none;
      border-radius: 16px;
      box-shadow: 0 4px 12px rgba(30, 30, 80, 0.2);
    }
    .card-petask .card-body { padding: 24px; }

    /* Campos de texto: altura mínima 56 px */
    .form-control {
      min-height: 56px;
      font-size: 16px;
      border-radius: 8px;
    }
    .form-control:focus {
      border-color: var(--azul);
      box-shadow: 0 0 0 0.2rem rgba(85, 127, 252, 0.25);
    }
    .form-label { font-size: 16px; }

    /* Botones: mínimo 45 px, 14 px, peso 500 */
    .btn-petask {
      background-color: var(--rosa);
      color: var(--azul-oscuro);
      font-size: 14px;
      font-weight: 500;
      min-width: 45px;
      min-height: 45px;
      border: none;
      border-radius: 8px;
    }
    .btn-petask:hover {
      background-color: var(--azul-claro);
      color: var(--azul-oscuro);
    }
    .btn-secundario {
      background-color: var(--azul-claro);
      color: var(--azul-oscuro);
      font-size: 14px;
      font-weight: 500;
      min-width: 45px;
      min-height: 45px;
      border: none;
      border-radius: 8px;
    }

    /* Alert: esquinas 8-50 px, padding 6-12 px, texto 16 px */
    .alert-petask {
      background-color: var(--azul-claro);
      color: var(--azul-oscuro);
      border: none;
      border-radius: 12px;
      padding: 12px;
      font-size: 16px;
    }

    /* Modal */
    .modal-content { border-radius: 16px; }
    .modal-title {
      font-family: 'Questrial', sans-serif;
      font-size: 22px;
      font-weight: 500;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand navbar-petask">
    <div class="container">
      <span class="navbar-brand">PetTask</span>
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="#">Tareas</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Mascota</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenedor, fila y columnas -->
  <main class="container my-4">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">

        <!-- Alert (oculta hasta guardar) -->
        <div id="alerta" class="alert alert-petask d-none mb-3" role="alert">
          ¡Los cambios de la tarea se guardaron correctamente!
        </div>

        <!-- Card con el formulario -->
        <div class="card card-petask">
          <div class="card-body">
            <h1 class="mb-3">Actualizar Tarea</h1>
            <p>Modifique los datos de la tarea seleccionada y guarde los cambios.</p>

            <form>
              <div class="mb-3">
                <label for="id" class="form-label">ID de la tarea</label>
                <input type="text" class="form-control" id="id">
              </div>

              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre de la tarea</label>
                <input type="text" class="form-control" id="nombre">
              </div>

              <div class="mb-3">
                <label for="descripcion" class="form-label">Descripción</label>
                <textarea class="form-control" id="descripcion" rows="4"></textarea>
              </div>

              <button type="button" class="btn btn-petask w-100"
                      data-bs-toggle="modal" data-bs-target="#modalConfirmar">
                Guardar cambios
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Modal de confirmación -->
  <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title">Confirmar cambios</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          ¿Desea guardar los cambios de la tarea?
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secundario" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-petask" onclick="guardarCambios()">Sí, guardar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- JavaScript personalizado -->
  <script>
    function guardarCambios() {
      const modal = bootstrap.Modal.getInstance(document.getElementById('modalConfirmar'));
      modal.hide();
      document.getElementById('alerta').classList.remove('d-none');
    }
  </script>

</body>
</html>
